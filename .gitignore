# Dependencies
node_modules/

# Build output (includes the generated service worker and manifest)
dist/
dev-dist/
*.tsbuildinfo

# Logs and editor/OS noise
*.log
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Local agent tooling
.ai/

# Personal data: real M8TRX backups contain loyalty card numbers and must
# never be committed. Tests generate synthetic backups in temporary folders.
*.m8trx

# Local secrets and environment configuration (an example file is allowed)
.env
.env.*
!.env.example

# Python bytecode from the scripts/ utilities
__pycache__/
*.pyc
